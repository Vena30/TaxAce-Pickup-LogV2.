# Neon Postgres connection string (Neon dashboard -> Connect -> pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Secret used to sign the staff-login session cookie (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Optional: shared password gate shown before staff login (leave blank to disable)
SITE_PASSWORD=
